# Optional Vercel frontend → backend gateway (set on the frontend only)
BACKEND_URL=
BACKEND_API_SECRET=
REQUIRE_GATEWAY=false

# Optional contest judge worker
JUDGE_IMAGE=blind-coding-sandbox
JUDGE_CONCURRENCY=2
