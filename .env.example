# Required by the website backend
DATABASE_URL=
REDIS_URL=redis://localhost:6379
ADMIN_PASSWORD=

# Optional backend tuning
PG_POOL_MAX=10
STORE_TABLE_ID=records
STORE_NAMESPACE=blind-coding-production
