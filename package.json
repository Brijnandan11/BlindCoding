{
  "name": "blind-coding",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs dev --hostname 0.0.0.0",
    "build": "node scripts/run.mjs build",
    "start": "node scripts/run.mjs start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "judge": "node scripts/run.mjs judge",
    "format": "prettier --write app components lib judge scripts tests next.config.ts",
    "test:load": "node scripts/load-test-suite.mjs",
    "db:migrate": "node scripts/setup-postgres.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "bullmq": "^5.0.0",
    "ioredis": "^5.0.0",
    "motion": "^12.0.0",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
